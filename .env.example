# Heorth environment template. Copy to `.env` and fill in every value below.
# `.env` is git-ignored; never commit it.
#
# Generate a secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Database --------------------------------------------------------------
# The password here must match POSTGRES_PASSWORD below when you use the bundled
# docker-compose.yml, which provisions this role and database for you.
# NEVER point this at a database you care about while running the test suite:
# `tests/setup.ts` truncates every table between tests and accepts only a name
# ending in `_test`.
POSTGRES_PASSWORD=<generate-a-strong-password>
DATABASE_URL=postgres://heorth:<generate-a-strong-password>@localhost:5432/heorth

# --- Auth ------------------------------------------------------------------
# 32+ characters. This secret ALSO derives the encryption key for stored
# Microsoft 365 refresh tokens, so rotating it forces every member to reconnect.
JWT_SECRET=<generate-a-32-char-minimum-random-string>
# The admin account seeded on first boot. Both are yours to choose; the email is
# only an identity, no mail is ever sent to it.
ADMIN_EMAIL=<your-admin-email>
ADMIN_PASSWORD=<generate-a-strong-password>
JWT_TTL_SECONDS=604800

# --- Server ----------------------------------------------------------------
HOUSEHOLD_NAME=Our Home
API_PORT=4000
DB_POOL_MAX=10

# --- CORS ------------------------------------------------------------------
# `*` lets ANY website make cross-origin requests to this API. It is fine on
# localhost and wrong everywhere else: Heorth holds household, calendar, and
# finance data. Set your real origin before exposing this beyond your machine,
# e.g. CORS_ORIGIN=https://heorth.home.example.com
CORS_ORIGIN=*

# Microsoft 365 integration (Phase 2) — canonical env names. Values come from
# the household tenant's app registration; the client secret lives ONLY in the
# local .env (dev) or deployment secrets (prod) — never in a repo.
M365_TENANT_ID=00000000-0000-0000-0000-000000000000
M365_CLIENT_ID=00000000-0000-0000-0000-000000000000
M365_CLIENT_SECRET=change-me
M365_REDIRECT_URI=http://localhost:4000/api/v1/m365/callback
M365_FAMILY_MAILBOX=family-calendar@example.com
M365_SHARED_TODO_LIST=Household
# Optional, INDEPENDENT of the all-or-nothing group above (tuning knob, not a
# credential): read-only calendar mirror poll interval in seconds (floored at 60).
M365_SYNC_INTERVAL_SECONDS=300
# Optional, INDEPENDENT of the all-or-nothing group above and of
# M365_SYNC_INTERVAL_SECONDS (tuning knob, not a credential): how often
# (seconds) a calendar feed does a deterministic full re-window even while its
# delta token is still valid, so the −60d/+400d window actually rolls forward
# instead of staying pinned to the window computed when the token was minted.
# Default 604800 (7 days) if unset.
M365_FULL_RESYNC_INTERVAL_SECONDS=604800

# KithLedger reminders (optional integration). Optional AS A GROUP: both set
# enables the /api/v1/kith proxy, both absent disables it; partial presence is
# a startup error.
#
# The key MUST be a HOUSEHOLD-kinded `kl_` key (ADR 0004 section 2): the
# reminders feed is always-on with no logged-in member, so it may only present
# the read-only, member-less household dashboard credential — which sees the
# `household`-visible slice and nothing private or shared-to-a-subset. Mint one
# in KithLedger as the local admin:
#   POST /api/v1/auth/keys {"name":"heorth-hearth-wall","kind":"household"}
# A member key here would give the wall that account's full personal scope and
# the ability to write. See README.md, "KithLedger reminders", for the full
# migration (including revoking the old key).
KITH_BASE_URL=
KITH_API_KEY=
# The operator's DECLARATION of which principal the key above is. Optional
# within the group; `household` is the only accepted value (Heorth cannot read
# a key's kind from the key itself, so this states it rather than checks it).
# Left blank here so copying this file verbatim leaves the group cleanly off.
KITH_API_KEY_KIND=

# Satellite identity signing key (optional). Heorth signs satellite-service
# tokens with this PRIVATE key and publishes only the public half at
# GET /.well-known/jwks.json, so a satellite can verify but never mint.
# SEPARATE from JWT_SECRET, which stays inside Heorth (it also derives the M365
# refresh-token encryption key) — do not reuse it here.
#
# Optional AS A GROUP: KEY + KID together enable it, both absent disables it
# (the JWKS then publishes {"keys": []}); partial presence is a startup error.
# Material is a PKCS#8 PEM or a JWK JSON string; a PEM may use literal \n
# escapes so it fits on one line. Generate with:
#   openssl genpkey -algorithm ed25519 -out satellite.key
# The private value belongs ONLY in the local .env (dev) or deployment secrets
# (prod) — never in a repo.
SATELLITE_SIGNING_KEY=
SATELLITE_SIGNING_KID=
# EdDSA (Ed25519, recommended default) or RS256. Optional within the group;
# left blank here so copying this file verbatim leaves the group cleanly off.
SATELLITE_SIGNING_ALG=
# Rotation-overlap slot: published in the JWKS but NEVER used for signing, so a
# new key can be pre-published or an old one kept verifiable while it retires.
# Accepts PUBLIC material too (so retired private keys can be deleted). Its kid
# must differ from the active one. See "Rotating the satellite signing key" in
# README.md for the full procedure. Leave unset when not rotating.
SATELLITE_SIGNING_KEY_SECONDARY=
SATELLITE_SIGNING_KID_SECONDARY=
SATELLITE_SIGNING_ALG_SECONDARY=
# The satellites POST /api/v1/auth/satellite-token will mint member tokens for
# (ADR 0009): a comma-separated allowlist of lowercase names, e.g.
# `kithledger`. Any other audience is refused, never minted optimistically —
# adding a satellite is meant to be a deliberate deployment change. Empty (the
# default) means the exchange endpoint refuses everything. Requires the active
# signing key above.
SATELLITE_AUDIENCES=
